{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "file:///opt/opencode-multi-auth-codex/dist/support-agent.js"
  ],
  "enabled_providers": [
    "openai"
  ],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Support",
          "limit": {
            "context": 128000,
            "output": 32000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          }
        }
      },
      "whitelist": [
        "gpt-5.6-sol"
      ]
    }
  },
  "model": "openai/gpt-5.6-sol",
  "small_model": "openai/gpt-5.6-sol",
  "permission": {
    "*": "deny"
  },
  "share": "disabled",
  "snapshot": false,
  "autoupdate": false,
  "formatter": false,
  "lsp": false,
  "mcp": {}
}
